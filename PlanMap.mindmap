        }
      }
    },
    {
      "id": "32a4d759-e4ba-4be9-83af-2599948c7bd6",
      "x": 1700,
      "y": 100,
      "width": 1480,
      "height": 860,
      "shape": "Rectangle",
      "text": "DOMAIN LAYER",
      "textStyle": {
        "fontFamily": "Segoe UI",
        "fontSize": 32,
        "bold": true,
        "italic": false,
        "underline": false,
